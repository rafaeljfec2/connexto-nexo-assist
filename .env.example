# Database
DATABASE_URL=postgres://nexo:nexo@localhost:5432/nexo

# API
API_PORT=3001
SESSION_SECRET=change-me-in-real-deployments
CORS_ORIGIN=http://localhost:3000
TICKET_FAULT=off
# Nest log levels: error | warn | log (default) | debug
# Agent business/tool traces use context AgentTrace — filter with: grep AgentTrace
LOG_LEVEL=log

# LLM — openai uses @mastra/core Agent (model router openai/<OPENAI_MODEL>)
# Set LLM_PROVIDER=scripted for CI / offline deterministic turns
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001

# Database
DATABASE_URL=postgres://nexo:nexo@localhost:5432/nexo

# API
API_PORT=3001
SESSION_SECRET=change-me-in-real-deployments
CORS_ORIGIN=http://localhost:3000
# Ticket gateway fault affordance: off | unavailable | fail_once (retry succeeds)
TICKET_FAULT=off
# Nest log levels: error | warn | log (default) | debug
# Agent business/tool traces use context AgentTrace — filter with: grep AgentTrace
LOG_LEVEL=log

# LLM
# - openrouter: Mastra model `openrouter/<OPENROUTER_MODEL>` (needs OPENROUTER_API_KEY)
# - openai: Mastra model `openai/<OPENAI_MODEL>` (needs OPENAI_API_KEY)
# - scripted: deterministic CI / offline turns
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# Optional OpenAI fallback
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4.1-mini

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001

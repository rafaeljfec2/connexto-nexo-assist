{
  "name": "nexo-assist",
  "private": true,
  "packageManager": "pnpm@11.28.9",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @nexo-assist/api db:generate",
    "db:migrate": "pnpm --filter @nexo-assist/api db:migrate",
    "db:seed": "pnpm --filter @nexo-assist/api db:seed"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
